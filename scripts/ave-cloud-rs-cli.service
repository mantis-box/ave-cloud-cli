[Unit]
Description=AVE Cloud RS CLI Daemon
Documentation=https://github.com/owner/ave-cloud-cli
After=network.target

[Service]
Type=simple
User=pi
EnvironmentFile=/etc/ave-cloud-cli/env

# Adjust path as needed
ExecStart=/usr/local/bin/ave-cloud-cli daemon --skill data-wss

Restart=on-failure
RestartSec=5

# Resource limits for Raspberry Pi
MemoryMax=64M
CPUQuota=20%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ave-cloud-cli

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
