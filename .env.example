# Ave Cloud API — get from https://cloud.ave.ai
AVE_API_KEY=your_api_key_here
API_PLAN=free

# Required for proxy wallet trading
# AVE_SECRET_KEY=your_hmac_secret_here

# Optional: chain wallet (self-custody)
# AVE_EVM_PRIVATE_KEY=0x_your_private_key_here
# AVE_SOLANA_PRIVATE_KEY=your_base58_private_key_here
# AVE_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Optional: custom RPC endpoints
# AVE_BSC_RPC_URL=https://bsc.publicnode.com
# AVE_ETH_RPC_URL=https://ethereum.publicnode.com
# AVE_BASE_RPC_URL=https://base.publicnode.com

# Logging
# RUST_LOG=info
